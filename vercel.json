{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/dimensjon-dekk",
      "destination": "/dekkdimensjon",
      "permanent": true
    },
    {
      "source": "/dekk-storrelser",
      "destination": "/dekkdimensjon",
      "permanent": true
    },
    {
      "source": "/dekk-lastebil",
      "destination": "/dekkdimensjon",
      "permanent": true
    },
    {
      "source": "/omregningstabell-dekk",
      "destination": "/overgangstabell-dekk",
      "permanent": true
    },
    {
      "source": "/rulleomkrets-dekk",
      "destination": "/rulleomkrets-kalkulator",
      "permanent": true
    },
    {
      "source": "/dekk-omkrets",
      "destination": "/rulleomkrets-kalkulator",
      "permanent": true
    },
    {
      "source": "/omkrets-til-diameter",
      "destination": "/rulleomkrets-kalkulator",
      "permanent": true
    },
    {
      "source": "/hastighet-kalkulator",
      "destination": "/speedometer-avvik",
      "permanent": true
    },
    {
      "source": "/km-t-kalkulator",
      "destination": "/speedometer-avvik",
      "permanent": true
    },
    {
      "source": "/dekktabell",
      "destination": "/dekk-felg-tabell",
      "permanent": true
    },
    {
      "source": "/hvilke-dekk-passer-min-bil",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/dekk-og-felg-kalkulator",
      "destination": "/felg-kalkulator",
      "permanent": true
    },
    {
      "source": "/dekk-kalkulator-bil",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
